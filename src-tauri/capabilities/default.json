{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the VideoEditing desktop shell.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:path:default",
    "core:app:default",
    "dialog:default",
    "notification:default",
    "shell:allow-open",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:scope-download-recursive",
    "fs:scope-video-recursive"
  ]
}
